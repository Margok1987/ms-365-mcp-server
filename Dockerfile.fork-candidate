FROM node:22-bookworm AS builder

WORKDIR /app

ADD https://github.com/Margok1987/ms-365-mcp-server/archive/f4034f9af77e324a751136895020651e3ca1bcff.tar.gz /tmp/source.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 -C /app \
    && rm -f /tmp/source.tar.gz

RUN npm ci
RUN npm run generate
RUN npm run build

FROM node:22-bookworm-slim AS release

WORKDIR /app

COPY --from=builder /app/dist /app/dist
COPY --from=builder /app/package*.json /app/

ENV NODE_ENV=production
RUN npm ci --ignore-scripts --omit=dev \
    && npm cache clean --force

LABEL org.opencontainers.image.source="https://github.com/Margok1987/ms-365-mcp-server" \
      org.opencontainers.image.revision="f4034f9af77e324a751136895020651e3ca1bcff" \
      org.opencontainers.image.title="WWW Microsoft 365 MCP fork candidate"

ENTRYPOINT ["node", "dist/index.js"]
